{
  "name": "personalos",
  "version": "0.1.0-alpha.8",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node apps/web/dev-server.mjs",
    "dev:api": "node apps/api/src/server.mjs",
    "setup": "node scripts/prepare-motion-ball.mjs && npm ci --prefix .build/motion-ball --registry=https://registry.npmjs.org --ignore-scripts --no-audit --no-fund",
    "build:web": "node scripts/build-motion-ball.mjs",
    "test:web": "node --experimental-vm-modules --test scripts/test-motion-host.mjs scripts/test-motion-weather.mjs scripts/test-native-card-layout.mjs scripts/test-navigation-host.mjs",
    "test:api": "node --test apps/api/test/*.test.mjs",
    "test:contracts": "node --test packages/contracts/test/*.test.mjs",
    "test:static": "node --test apps/web/static-server.test.mjs",
    "test": "npm run test:contracts && npm run test:api && npm run test:static && npm run test:web",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:motion": "node scripts/check-motion-ball-source.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:public": "node scripts/check-public-export.mjs",
    "check": "npm run check:provenance && npm run check:motion && npm run check:syntax && npm run check:public"
  },
  "devDependencies": {
    "jsdom": "30.1.1"
  }
}
